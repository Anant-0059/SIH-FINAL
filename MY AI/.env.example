# ============================================================================
# AVRENYX — "One Workspace. Every AI. Every Creation."
# Free-first, subscription-free, multi-AI operating workspace configuration
# ============================================================================

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/avrenyx?schema=public"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="replace-with-32-byte-cryptographic-random-secret"
ENCRYPTION_KEY="replace-with-64-hex-chars-for-aes-256-gcm-encryption"

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin System RBAC Configuration (Argon2id / PBKDF2 / SHA-256 Hash)
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Optional Server-Level Default Provider Keys (Users can also connect BYOK in UI)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
XAI_API_KEY=""
MISTRAL_API_KEY=""
COHERE_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
TOGETHER_API_KEY=""
FIREWORKS_API_KEY=""
CEREBRAS_API_KEY=""
REPLICATE_API_KEY=""
HF_API_KEY=""
ZAI_API_KEY=""

# Local AI Runtime (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# S3-Compatible Storage (Local filesystem used automatically in development)
STORAGE_ENDPOINT=""
STORAGE_BUCKET="avrenyx-storage"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
