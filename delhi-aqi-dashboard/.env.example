# Official AQI.in API Key (Optional: if provided, uses https://apiserver.aqi.in/api/v1/getCityData)
# Configure in .env.local — never expose in client-side code
AQI_IN_API_KEY=

# CPCB Real-time Air Quality Data API Key (from data.gov.in)
DATA_GOV_IN_API_KEY=

# Server-side cache TTL for live endpoint in seconds (default: 30 seconds)
LIVE_TTL_SECONDS=30

# Application Branding
NEXT_PUBLIC_APP_NAME=Delhi NCR Air Quality Intelligence Dashboard
